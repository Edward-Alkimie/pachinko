# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose + Django) ---
# Leave POSTGRES_HOST unset to use SQLite (backend/db.sqlite3) for local development.
POSTGRES_DB=pachinko
POSTGRES_USER=pachinko
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
# Required. Signs sessions + CSRF tokens; keep it secret, one per machine.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST with cookies, e.g. the code-server URL
DJANGO_CSRF_TRUSTED_ORIGINS=
AUTH_THROTTLE_RATE=10/min
# Reverse proxies in front of Django (0 locally). Rate limit is per process (local-memory cache).
DJANGO_NUM_PROXIES=0

# --- Physics service (Node) ---
PHYSICS_SERVICE_PORT=8100
PHYSICS_SERVICE_URL=http://localhost:8100

# --- Frontend (Vite) ---
# Leave VITE_API_URL unset: the page calls <base>api and Vite proxies it to Django,
# so session cookies are same-origin. BACKEND_URL = where that proxy points.
# VITE_API_URL=
BACKEND_URL=http://127.0.0.1:8000

# --- Sui (testnet) ---
# JSON-RPC is off on public testnet full nodes; use GraphQL (or gRPC on fullnode.testnet.sui.io:443).
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Key for `npm run round:testnet` (admin + operator + player in the demo). Testnet only, never commit.
# Export: sui keytool export --key-identity <address>   → copy the suiprivkey1… value
SUI_PRIVATE_KEY=
# Optional second key for `npm run forged:testnet` (the challenger; needs its own testnet SUI).
# Unset = the main key also challenges, so the bond transfer goes back to the same address.
# CHALLENGER_PRIVATE_KEY=
# Optional round settings (MIST; 1 SUI = 1_000_000_000). Defaults shown.
# PACHINKO_BET_MIST=10000000
# PACHINKO_HOUSE_FUNDS_MIST=50000000
# PACHINKO_OPERATOR_BOND_MIST=10000000
# PACHINKO_CHALLENGER_BOND_MIST=10000000
# PACHINKO_CHALLENGE_WINDOW_MS=30000
# Payout per pocket in basis points (10000 = 1x), 7 values. Placeholder: flat 1x (open decision #1).
# PACHINKO_MULTIPLIERS_BPS=10000,10000,10000,10000,10000,10000,10000
