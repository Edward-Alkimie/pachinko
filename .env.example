# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose + Django) ---
# Leave POSTGRES_HOST unset to use SQLite (backend/db.sqlite3) for local development.
POSTGRES_DB=pachinko
POSTGRES_USER=pachinko
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
# Required. Signs sessions + CSRF tokens; keep it secret, one per machine.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST with cookies, e.g. the code-server URL
DJANGO_CSRF_TRUSTED_ORIGINS=
AUTH_THROTTLE_RATE=10/min
# Reverse proxies in front of Django (0 locally). Rate limit is per process (local-memory cache).
DJANGO_NUM_PROXIES=0

# --- Physics service (Node) ---
PHYSICS_SERVICE_PORT=8100
PHYSICS_SERVICE_URL=http://localhost:8100

# --- Frontend (Vite) ---
# Leave VITE_API_URL unset: the page calls <base>api and Vite proxies it to Django,
# so session cookies are same-origin. BACKEND_URL = where that proxy points.
# VITE_API_URL=
BACKEND_URL=http://127.0.0.1:8000

# --- Sui (testnet) ---
# JSON-RPC is off on public testnet full nodes; use GraphQL (or gRPC on fullnode.testnet.sui.io:443).
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Your key: deploy:testnet makes it admin + operator; the operator and bet:testnet sign with it. Testnet only, never commit.
# Export: sui keytool export --key-identity <address>   → copy the suiprivkey1… value
SUI_PRIVATE_KEY=
# Operator key for `npm run operator`. Leave it out to use SUI_PRIVATE_KEY (normal case: that key
# ran deploy:testnet, so it owns the OperatorCap). Set it only to run the operator from a different
# address, which must own the OperatorCap of your deployment.
# OPERATOR_PRIVATE_KEY=
# Demo only: make the operator forge every result, so a challenge can catch it.
# shortchange = every ball reported as never landed (the player is paid nothing).
# OPERATOR_CHEAT=shortchange
# Your deployment (your own copy of the contracts): chain/src/deployments/<name>.json.
# Created by `npm run deploy:testnet`; used by round/forged/bet:testnet and the operator.
PACHINKO_DEPLOYMENT=
# The deployment the web page plays on ("Play on-chain"); usually the same name. Unset = on-chain play off.
# Only VITE_* values are given to the page (vite.config.ts envDir), so the keys above stay private.
VITE_PACHINKO_DEPLOYMENT=
# Optional settings (MIST; 1 SUI = 1_000_000_000). Defaults shown.
# Bet per round (bet:testnet):
# PACHINKO_BET_MIST=10000000
# House settings, used by deploy:testnet (saved in your deployment file):
# PACHINKO_HOUSE_FUNDS_MIST=50000000
# PACHINKO_OPERATOR_BOND_MIST=10000000
# PACHINKO_CHALLENGER_BOND_MIST=10000000
# PACHINKO_CHALLENGE_WINDOW_MS=30000
# Payout per pocket in basis points (10000 = 1x), 7 values. Placeholder: flat 1x (open decision #1).
# PACHINKO_MULTIPLIERS_BPS=10000,10000,10000,10000,10000,10000,10000
