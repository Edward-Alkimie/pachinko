{
  "name": "pachinko",
  "private": true,
  "type": "module",
  "workspaces": ["physics", "chain", "frontend", "physics-service", "scripts"],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:physics-service": "npm run dev -w physics-service",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "replay": "npm run replay -w physics-service --",
    "operator": "npm run operator -w physics-service",
    "verifier": "npm run verifier -w physics-service",
    "deploy:testnet": "npm run deploy:testnet -w scripts",
    "bet:testnet": "npm run bet:testnet -w scripts",
    "verifiers:setup": "npm run verifiers:setup -w scripts"
  }
}
